import hashlib
import time
import json
import os

# -----------------------------
# BLOCK CLASS
# -----------------------------
class Block:
    def __init__(self, index, contract_hash, owner, evidence, previous_hash):
        self.index = index
        self.timestamp = time.ctime()
        self.contract_hash = contract_hash
        self.owner = owner
        self.evidence = evidence
        self.previous_hash = previous_hash
        self.hash = self.calculate_hash()

    def calculate_hash(self):
        data = str(self.index) + self.timestamp + self.contract_hash + self.owner + str(self.evidence) + self.previous_hash
        return hashlib.sha256(data.encode()).hexdigest()


# -----------------------------
# BLOCKCHAIN CLASS
# -----------------------------
class Blockchain:
    def __init__(self):
        self.chain = []
        self.load_chain()

        # If no chain exists, create genesis block
        if len(self.chain) == 0:
            genesis = Block(0, "0", "Genesis", "None", "0")
            self.chain.append(genesis)
            self.save_chain()

    def add_block(self, contract_hash, owner, evidence):
        previous_block = self.chain[-1]
        new_block = Block(len(self.chain), contract_hash, owner, evidence, previous_block.hash)
        self.chain.append(new_block)
        self.save_chain()

    def save_chain(self):
        with open("blockchain.json", "w") as f:
            json.dump([block.__dict__ for block in self.chain], f, indent=4)

    def load_chain(self):
        if os.path.exists("blockchain.json"):
            with open("blockchain.json", "r") as f:
                data = json.load(f)
                self.chain = []
                for item in data:
                    block = Block(
                        item['index'],
                        item['contract_hash'],
                        item['owner'],
                        item['evidence'],
                        item['previous_hash']
                    )
                    block.timestamp = item['timestamp']
                    block.hash = item['hash']
                    self.chain.append(block)

    def display_chain(self):
        for block in self.chain:
            print("\n---------------------------")
            print("Index:", block.index)
            print("Time:", block.timestamp)
            print("Owner:", block.owner)
            print("Contract Hash:", block.contract_hash)
            print("Evidence:", block.evidence)
            print("Hash:", block.hash)
            print("Previous Hash:", block.previous_hash)

# -----------------------------
# HASH FUNCTION
# -----------------------------
def generate_file_hash(file_path):
    sha256 = hashlib.sha256()

    try:
        with open(file_path, "rb") as f:
            while True:
                chunk = f.read(4096)
                if not chunk:
                    break
                sha256.update(chunk)
        return sha256.hexdigest()
    except:
        return None


# -----------------------------
# MAIN SYSTEM
# -----------------------------
def main():
    blockchain = Blockchain()

    while True:
        print("\n====== Digital Contract Forensics System ======")
        print("1. Add New Contract")
        print("2. Verify Contract")
        print("3. View Blockchain")
        print("4. Exit")

        choice = input("Enter choice: ")

        # -----------------------------
        # ADD CONTRACT
        # -----------------------------
        if choice == '1':
            file_path = input("Enter contract file path: ")
            owner = input("Enter owner name: ")
            evidence = input("Enter evidence (email/time/log): ")

            file_hash = generate_file_hash(file_path)

            if file_hash:
                print("\nHash Generated:", file_hash)
                blockchain.add_block(file_hash, owner, evidence)
                print(" Contract added to blockchain!")
            else:
                print(" File not found!")

        # -----------------------------
        # VERIFY CONTRACT
        # -----------------------------
        elif choice == '2':
            file_path = input("Enter contract file path to verify: ")
            new_hash = generate_file_hash(file_path)

            if not new_hash:
                print(" File not found!")
                continue

            print("\nNew Hash:", new_hash)

            found = False
            for block in blockchain.chain:
                if block.contract_hash == new_hash:
                    print("Contract is VALID (Found in blockchain)")
                    print("Owner:", block.owner)
                    print("Timestamp:", block.timestamp)
                    found = True
                    break

            if not found:
                print(" Contract NOT FOUND or TAMPERED!")

        # -----------------------------
        # VIEW BLOCKCHAIN
        # -----------------------------
        elif choice == '3':
            blockchain.display_chain()

        # -----------------------------
        # EXIT
        # -----------------------------
        elif choice == '4':
            print("Exiting...")
            break

        else:
            print("Invalid choice!")

# -----------------------------
# RUN PROGRAM
# -----------------------------
if __name__ == "__main__":
    main()
